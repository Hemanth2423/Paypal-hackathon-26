# Braintree sandbox credentials (Control Panel → Settings → API)
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
# Optional: merchant account used for historical (Route A) renewals. Defaults to the account's default.
BRAINTREE_MERCHANT_ACCOUNT_ID=

# PayPal REST sandbox (reserved for v2 wallet arm)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI provider: any OpenAI-compatible endpoint on a free tier (see TechSpec.md)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
