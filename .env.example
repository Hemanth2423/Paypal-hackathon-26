# Braintree sandbox credentials (Control Panel → Settings → API)
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
# Optional: merchant account used for historical (Route A) renewals. Defaults to the account's default.
BRAINTREE_MERCHANT_ACCOUNT_ID=

# Trial run (F4). "standin" runs the trial on a stand-in gateway that follows the sandbox's rules (banner says so);
# leave empty to charge the Braintree sandbox.
TRIAL_GATEWAY=
# Optional: sandbox calls the trial makes at once, 1-32 (default 16; a full run takes about 1 minute). Set 8 if the
# sandbox starts throttling: the run then takes about 1.5 minutes.
TRIAL_CONCURRENCY=
# Optional: a second sandbox merchant account for Route B. Without it, both routes use one account and sm_route tags each sale.
BRAINTREE_ROUTE_B_ACCOUNT_ID=

# PayPal REST sandbox (reserved for v2 wallet arm)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI provider: any OpenAI-compatible endpoint on a free tier (see TechSpec.md)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
