<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="title" value="AWS Web Application Architecture" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
      <mxGeometry x="350" y="10" width="450" height="40" as="geometry"/>
    </mxCell>

    <!-- AWS Cloud Boundary -->
    <mxCell id="aws-cloud" value="AWS Cloud" style="swimlane;startSize=30;fillColor=#F2F2F2;strokeColor=#232F3E;strokeWidth=2;rounded=1;arcSize=4;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="150" width="800" height="520" as="geometry"/>
    </mxCell>

    <!-- VPC -->
    <mxCell id="vpc" value="VPC 10.0.0.0/16" style="swimlane;startSize=25;fillColor=#E6F2FF;strokeColor=#6C8EBF;strokeWidth=1;dashed=1;rounded=1;arcSize=6;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="aws-cloud">
      <mxGeometry x="30" y="60" width="740" height="430" as="geometry"/>
    </mxCell>

    <!-- Public Subnet -->
    <mxCell id="pub-subnet" value="Public Subnet" style="swimlane;startSize=22;fillColor=#FFF9E6;strokeColor=#D6B656;dashed=1;rounded=1;arcSize=6;fontSize=11;html=1;" vertex="1" parent="vpc">
      <mxGeometry x="20" y="40" width="220" height="360" as="geometry"/>
    </mxCell>

    <mxCell id="alb" value="Application&#xa;Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="pub-subnet">
      <mxGeometry x="25" y="50" width="170" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="nat" value="NAT Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="pub-subnet">
      <mxGeometry x="25" y="260" width="170" height="50" as="geometry"/>
    </mxCell>

    <!-- Private Subnet -->
    <mxCell id="priv-subnet" value="Private Subnet" style="swimlane;startSize=22;fillColor=#E8F5E9;strokeColor=#82B366;dashed=1;rounded=1;arcSize=6;fontSize=11;html=1;" vertex="1" parent="vpc">
      <mxGeometry x="280" y="40" width="430" height="360" as="geometry"/>
    </mxCell>

    <mxCell id="ecs" value="ECS Fargate&#xa;(API Services)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="priv-subnet">
      <mxGeometry x="30" y="50" width="170" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="lambda" value="Lambda&#xa;(Background Jobs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="priv-subnet">
      <mxGeometry x="240" y="50" width="170" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="rds" value="RDS PostgreSQL&#xa;(Primary)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;boundedLbl=1;size=12;" vertex="1" parent="priv-subnet">
      <mxGeometry x="30" y="170" width="170" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="elasticache" value="ElastiCache&#xa;(Redis)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;boundedLbl=1;size=12;" vertex="1" parent="priv-subnet">
      <mxGeometry x="240" y="170" width="170" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="sqs" value="SQS Queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="priv-subnet">
      <mxGeometry x="130" y="280" width="170" height="50" as="geometry"/>
    </mxCell>

    <!-- Edges inside VPC -->
    <mxCell id="e-alb-ecs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666;" edge="1" source="alb" target="ecs" parent="vpc">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-ecs-rds" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;fontSize=9;" edge="1" source="ecs" target="rds" parent="vpc">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-ecs-redis" value="cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;fontSize=9;" edge="1" source="ecs" target="elasticache" parent="vpc">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-ecs-sqs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;dashed=1;" edge="1" source="ecs" target="sqs" parent="vpc">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-sqs-lambda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;dashed=1;" edge="1" source="sqs" target="lambda" parent="vpc">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- External — Users + CloudFront + Route53 -->
    <mxCell id="users" value="Users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="30" y="210" width="100" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="cloudfront" value="CloudFront&#xa;(CDN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="30" y="340" width="100" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="s3" value="S3&#xa;(Static Assets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="30" y="470" width="100" height="60" as="geometry"/>
    </mxCell>

    <!-- External edges -->
    <mxCell id="e-users-cf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666;" edge="1" source="users" target="cloudfront" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-users-alb" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666;fontSize=10;" edge="1" source="users" target="alb" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-cf-s3" value="origin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;fontSize=9;" edge="1" source="cloudfront" target="s3" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
